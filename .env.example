# Optional: a broker you own, tried first; the public brokers stay as fallbacks.
# A free HiveMQ Cloud instance works. Set these in Netlify (Site settings →
# Environment variables) or in a local .env before `npm run build`.
# Credentials in a static site are public — use a broker you are happy to expose.
VITE_MQTT_URL=wss://xxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt
VITE_MQTT_USERNAME=
VITE_MQTT_PASSWORD=
